#!/bin/bash
set -euo pipefail

# Example only. Do not commit real API keys.
# Copy this file to start_gateway_with_env.sh and replace the key.
#
# The current project often listens on port 80, which requires sudo.
# If you run on port 8080 later, sudo is not needed.

export GEMINI_API_KEY="replace_with_your_key"
export LIGHTAGENT_DEFAULT_PROVIDER="gemini"
export LIGHTAGENT_FALLBACK_PROVIDER="ollama"
export OLLAMA_BASE_URL="http://127.0.0.1:11434"

sudo GEMINI_API_KEY="${GEMINI_API_KEY}" \
  LIGHTAGENT_DEFAULT_PROVIDER="${LIGHTAGENT_DEFAULT_PROVIDER}" \
  LIGHTAGENT_FALLBACK_PROVIDER="${LIGHTAGENT_FALLBACK_PROVIDER}" \
  OLLAMA_BASE_URL="${OLLAMA_BASE_URL}" \
  ./WebServer
